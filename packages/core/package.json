{
  "name": "@shiro/core",
  "version": "0.0.0",
  "description": "Core SDK package for Shiro.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup ./src/index.ts --format esm --clean && tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "devDependencies": {
    "rimraf": "^6.0.1",
    "zod": "^4.0.0"
  }
}
