{
  "name": "@shiro/core",
  "version": "0.0.0",
  "description": "Core SDK package for Shiro.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/shiro-sdk/shiro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiro-sdk/shiro.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/shiro-sdk/shiro/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agents",
    "sdk",
    "typescript",
    "llm",
    "orchestration"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf .tsbuildinfo && tsup ./src/index.ts --format esm --clean && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "zod": "^4.0.0"
  }
}
