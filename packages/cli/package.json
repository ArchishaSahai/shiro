{
  "name": "@shiro-sdk/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Shiro.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://shiro-docs.vercel.app/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchishaSahai/shiro.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ArchishaSahai/shiro/issues"
  },
  "keywords": [
    "shiro",
    "ai",
    "agent",
    "cli",
    "typescript",
    "scaffold"
  ],
  "types": "./dist/index.d.ts",
  "bin": {
    "shiro": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf .tsbuildinfo && tsup ./src/index.ts --format esm --dts --clean",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "ora": "^9.0.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@shiro-sdk/studio": "workspace:*",
    "@types/prompts": "^2.4.9",
    "rimraf": "^6.0.1"
  }
}
